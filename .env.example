PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# PostgreSQL + pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_assistant

# Better Auth
BETTER_AUTH_SECRET=your-secret-key-at-least-32-chars-long
BETTER_AUTH_URL=http://localhost:3001

# S3-Compatible Object Storage (e.g. Neon S3, AWS S3, MinIO, Cloudflare R2)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-s3-access-key
AWS_SECRET_ACCESS_KEY=your-s3-secret-key
AWS_ENDPOINT_URL_S3=https://your-s3-endpoint
S3_BUCKET=your-bucket-name

# LLM Provider (Groq / OpenAI-compatible)
AI_API_KEY=your-groq-api-key
AI_API_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-20b

# Vector Embeddings (Jina AI)
JINA_API_KEY=your-jina-api-key
EMBEDDING_MODEL=jina-embeddings-v3
